# Geotherm – Umgebungsvariablen (Vorlage)
# Kopieren nach .env.local und mit echten Werten befüllen.
# NIEMALS .env.local committen!

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Feedback-System (server-only!) ───────────────────────────────────────────
GITHUB_FEEDBACK_TOKEN=github_pat_…
GITHUB_FEEDBACK_REPO=cryptoclemens/geotherm

# ── KI (Server-only) ─────────────────────────────────────────────────────────
# Standard-Anthropic-Key (Fallback wenn Nutzer keinen eigenen Key hinterlegt hat)
ANTHROPIC_API_KEY=sk-ant-api03-…

# ── BYOK Verschlüsselung (Server-only!) ──────────────────────────────────────
# 32 Bytes, base64-kodiert — wird zum Verschlüsseln aller Nutzer-API-Keys verwendet.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ACHTUNG: Verlust dieses Secrets macht alle gespeicherten Nutzer-Keys unlesbar!
API_KEY_ENCRYPTION_SECRET=<32-byte-base64-secret>

# Optionale Server-seitige Fallback-Keys pro Provider
# (werden genutzt wenn Nutzer keinen eigenen Key hinterlegt hat)
# OPENAI_API_KEY=sk-proj-…
# AZURE_OPENAI_API_KEY=<azure-key>
# AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
# PERPLEXITY_API_KEY=pplx-…

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://geotherm.vencly.com
NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_GIT_SHA wird von Vercel automatisch gesetzt
